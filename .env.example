# Copy to .env (git-ignored, chmod 600) and fill in. Names only; never commit values.

# --- Catalyst Center -----------------------------------------------------------------------
CATC_URL=https://catalyst-center.example.com
CATC_USERNAME=
CATC_PASSWORD=
# or a pre-issued X-Auth-Token instead of username/password (expires after ~1h):
# CATC_TOKEN=
CATC_VERIFY_SSL=true
# CATC_CA_BUNDLE=/path/to/ca.pem
# CATC_TIMEOUT=30
# CATC_RETRIES=2
# CATC_RATE_LIMIT=            # requests per minute (client-side pacing; 429s are retried anyway)
# CATC_MAX_CONCURRENCY=8
# CATC_COMMAND_RUNNER_TIMEOUT=120

# --- MCP server ----------------------------------------------------------------------------
# MCP_TRANSPORT=stdio          # or http
# MCP_HOST=0.0.0.0
# MCP_PORT=8000
# MCP_PATH=/mcp
# MCP_AUTH_TOKENS=             # name:sha256:<hex>, from `catc-mcp-server token <name>`
# MCP_ENABLE_WRITES=false
# MCP_ENABLE_DANGEROUS=false
# MCP_CONFIRM_TTL=600
# MCP_TASK_TIMEOUT=600
# MCP_CACHE_DIR=
# MCP_MAX_RESPONSE_CHARS=40000
# MCP_AUDIT_LOG=stderr
# LOG_LEVEL=INFO

# --- Live tests (tests/live; docs/live-tests.md). Unset ones make their tests skip. ---------
# Least-privilege accounts (docs/least-privilege.md):
# CATC_RO_USERNAME=
# CATC_RO_PASSWORD=
# CATC_RW_USERNAME=
# CATC_RW_PASSWORD=
# Two managed IOS-XE routers (OSPF neighbours over GigabitEthernet2) and where they are provisioned:
# CATC_LIVE_ROUTER1=192.0.2.11
# CATC_LIVE_ROUTER2=192.0.2.12
# CATC_LIVE_PATH_TRACE=10.255.255.1,10.255.255.2   # optional; default router1,router2
# CATC_LIVE_BUILDING=Global/Lab/Building1
# CATC_LIVE_FLOOR=Global/Lab/Building1/Floor1
# CATC_LIVE_CLIENT_MAC=00:00:5e:00:53:01            # optional
# A switch not yet in the inventory (onboarding and AAA tests):
# CATC_LIVE_ONBOARD_SWITCH=192.0.2.20
# ISE integration and site AAA:
# CATC_LIVE_ISE_IP=192.0.2.30
# CATC_LIVE_ISE_FQDN=ise.example.com
# CATC_LIVE_ISE_USERNAME=
# CATC_LIVE_ISE_PASSWORD=
# CATC_LIVE_RADIUS_SECRET=
# CATC_LIVE_ISE_CYCLE=1                             # optional: rebuild an existing integration
# Wireless:
# CATC_LIVE_WLC=192.0.2.40
# SD-Access:
# CATC_LIVE_FABRIC_BUILDING=Global/Lab/Fabric1
# CATC_LIVE_FABRIC_BORDER=192.0.2.51
# CATC_LIVE_FABRIC_EDGE=192.0.2.52
# CATC_LIVE_FABRIC_POOL=fabric-clients
# CATC_LIVE_FABRIC_PORT=GigabitEthernet1/0/3        # optional (default shown)
# Plug and Play claim (day-0 credentials for the claimed device) and RMA:
# CATC_LIVE_PNP_SERIAL=auto                         # a serial, or auto = first Unclaimed C8000V
# CATC_LIVE_DEVICE_USERNAME=
# CATC_LIVE_DEVICE_PASSWORD=
# CATC_LIVE_SNMP_RO=
# CATC_LIVE_SNMP_RW=
# CATC_LIVE_RMA=1
# CATC_LIVE_RMA_DEVICE=192.0.2.12                   # optional; default CATC_LIVE_ROUTER2
