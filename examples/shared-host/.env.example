# Shared-host settings for examples/shared-host (docs/deploying.md). Copy to .env, chmod 600, never commit it.

# Image: pin a version on a shared host (latest / rc also exist)
MCP_IMAGE_TAG=latest

# TLS (Caddy): the name clients use, and "internal" or your ACME e-mail address
MCP_HOSTNAME=mcp-catc.example.com
CADDY_TLS=internal

# The default Catalyst Center and a least-privilege account (role mcp-catc-ro, docs/least-privilege.md)
CATC_URL=https://catalyst-center.example.com
CATC_USERNAME=mcp-catc-ro
CATC_PASSWORD=
# CATC_PASSWORD_FILE=/run/secrets/catc_password   # preferred: a Docker secret instead of a value here
# CATC_CA_BUNDLE=/certs/catc-ca.pem
# CATC_RATE_LIMIT=                                # requests/min to this CatC, shared by every caller

# More Catalyst Centers (optional): each has its own URL, account and TLS settings
# CATC_INSTANCES=lab
# CATC_LAB_URL=https://catc-lab.example.com
# CATC_LAB_USERNAME=mcp-catc-ro
# CATC_LAB_PASSWORD=
# CATC_LAB_READ_ONLY=true

# One token per person: catc-mcp-server token <name>, then paste the name:sha256:<hex> lines here
MCP_AUTH_TOKENS=

# Read-only unless you opt in. With writes on, MCP_ROLES decides who may use them (ro / rw / admin).
# MCP_ENABLE_WRITES=false
# MCP_ENABLE_DANGEROUS=false
# MCP_ROLES=alice:rw,bob:ro
# Change rails for a team (docs/deploying.md): most devices per change, and when changes may happen
# CATC_MAX_DEVICES_PER_CHANGE=10
# MCP_CHANGE_WINDOW=
